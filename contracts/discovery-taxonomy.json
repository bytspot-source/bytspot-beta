{
  "$schema": "bytspot.discovery-taxonomy/v1",
  "version": 1,
  "description": "Hand-authored source of truth for the consumer discovery taxonomy: the thirteen browse rails, the exact category aliases that resolve onto them, the capability indicator vocabulary, and which capabilities earn the premium chassis. This file is NOT generated. scripts/assert-discovery-taxonomy.mjs verifies the hand-written Swift and TypeScript against it and fails naming any category that has no rail.",
  "verifies": {
    "swift": "ios/App/App/NativeDiscoverListing.swift",
    "typescript": "src/utils/discoveryRails.ts"
  },
  "fallbackRail": "explore",
  "fallbackPolicy": "A category with no alias resolves to the fallback rail so the place stays visible and routable. It is never hidden: capability is gated separately, and an unmapped place renders as Listed, which promises nothing. The parity gate fails and names the category so the alias can be added.",
  "rails": [
    {
      "token": "explore",
      "label": "Explore"
    },
    {
      "token": "eat_drink",
      "label": "Eat & Drink"
    },
    {
      "token": "shop_style",
      "label": "Shop & Style"
    },
    {
      "token": "experience",
      "label": "Experience"
    },
    {
      "token": "social",
      "label": "Social"
    },
    {
      "token": "events",
      "label": "Events"
    },
    {
      "token": "wellness",
      "label": "Wellness"
    },
    {
      "token": "create_learn",
      "label": "Create & Learn"
    },
    {
      "token": "nightlife",
      "label": "Nightlife"
    },
    {
      "token": "stay",
      "label": "Stay"
    },
    {
      "token": "move",
      "label": "Move"
    },
    {
      "token": "celebrate",
      "label": "Celebrate"
    },
    {
      "token": "services",
      "label": "Services"
    }
  ],
  "aliases": {
    "all": "explore",
    "dining": "eat_drink",
    "coffee": "eat_drink",
    "restaurant": "eat_drink",
    "cafe": "eat_drink",
    "café": "eat_drink",
    "food-drink": "eat_drink",
    "catering": "eat_drink",
    "market": "eat_drink",
    "shopping": "shop_style",
    "retail": "shop_style",
    "fashion": "shop_style",
    "styling": "shop_style",
    "culture": "experience",
    "outdoor": "experience",
    "sports": "experience",
    "museum": "experience",
    "attraction": "experience",
    "tour": "experience",
    "park": "experience",
    "community": "social",
    "meetup": "social",
    "fan-meetup": "social",
    "entertainment": "events",
    "event": "events",
    "event pass": "events",
    "music": "events",
    "fitness": "wellness",
    "spa": "wellness",
    "gym": "wellness",
    "recovery": "wellness",
    "class": "create_learn",
    "workshop": "create_learn",
    "tutoring": "create_learn",
    "studio": "create_learn",
    "education": "create_learn",
    "bar": "nightlife",
    "club": "nightlife",
    "night_club": "nightlife",
    "boutique_apartment": "stay",
    "boutique stay": "stay",
    "hotel": "stay",
    "lodging": "stay",
    "mobility": "move",
    "automotive": "move",
    "transport": "move",
    "parking": "move",
    "stall": "move",
    "valet": "move",
    "party": "celebrate",
    "private-party": "celebrate",
    "celebration": "celebrate",
    "wedding": "celebrate",
    "birthday": "celebrate",
    "service": "services",
    "green": "services",
    "local-service": "services"
  },
  "cardIndicator": {
    "description": "One word, one ring and one colour per capability, read by the discover card, the venue detail, the grant preview and the plan row. Blue marks an action Bytspot can execute; an external handoff and a bare listing stay neutral.",
    "order": [
      "book",
      "order",
      "request",
      "redirect",
      "details"
    ],
    "capabilities": {
      "book": {
        "label": "Book",
        "ring": "solid",
        "actionHex": "0x00BFFF"
      },
      "order": {
        "label": "Order",
        "ring": "segmented",
        "actionHex": "0x00BFFF"
      },
      "request": {
        "label": "Request",
        "ring": "dashed",
        "actionHex": "0x00BFFF"
      },
      "redirect": {
        "label": "External",
        "ring": "dot",
        "actionHex": null
      },
      "details": {
        "label": "Listed",
        "ring": "dot",
        "actionHex": null
      }
    },
    "ringDashPatterns": {
      "solid": [],
      "segmented": [
        4,
        2
      ],
      "dashed": [
        2,
        2
      ],
      "dot": []
    }
  },
  "chassis": {
    "description": "The premium presentation is earned by supply, never granted by a rail. A rail never selects a chassis: Nightlife and Stay render identically. Capability selects it, because capability is supply-asserted.",
    "premium": [
      "book",
      "order",
      "request"
    ],
    "plain": [
      "redirect",
      "details"
    ],
    "partyOverride": {
      "premium": true,
      "reason": "A published party is supply: the host asserted admission and capacity, and the Party Pass flow really executes. Parties resolve to the internal `details` capability only because they run on the RSVP/ticket path instead of the bookable one, so without this override every host would be silently demoted to the plain chassis."
    }
  }
}
