require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    # Authenticate with App Store Connect API (no 2FA issues in CI)
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    # Choose a build number that is always strictly higher than TestFlight,
    # and also unique across GitHub reruns/overlapping CI executions.
    latest = latest_testflight_build_number(
      api_key:        api_key,
      app_identifier: "com.bytspot.app",
      initial_build_number: 63
    )
    next_remote_build = latest.to_i + 1

    github_run_id = ENV["GITHUB_RUN_ID"].to_s[/\d+/].to_i
    github_run_attempt = ENV.fetch("GITHUB_RUN_ATTEMPT", "1").to_i
    ci_build = if github_run_id.positive?
      format("%d%02d", github_run_id, github_run_attempt).to_i
    else
      0
    end

    timestamp_build = Time.now.utc.strftime("%y%m%d%H%M%S").to_i
    candidate_builds = [next_remote_build, timestamp_build]
    candidate_builds << ci_build if ci_build.positive?

    new_build = candidate_builds.max.to_s
    UI.message(
      "Build number candidates → latest+1=#{next_remote_build}, " \
      "timestamp=#{timestamp_build}, " \
      "ci=#{ci_build.positive? ? ci_build : 'n/a'}; using #{new_build}"
    )
    increment_build_number(
      xcodeproj:    "App.xcodeproj",
      build_number: new_build
    )

    # Wire the App Clip target into the Xcode project (idempotent).
    sh "bundle exec ruby ../scripts/add_app_clip_target.rb"

    # Switch Release config to manual signing for CI for both targets
    # (local dev uses Automatic via Xcode, CI uses manual with provisioning profile)
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "App.xcodeproj",
      team_id:               ENV["APPLE_TEAM_ID"],
      targets:               ["App"],
      bundle_identifier:     "com.bytspot.app",
      profile_uuid:          ENV["PROVISIONING_PROFILE_UUID"],
      code_sign_identity:    "Apple Distribution"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "App.xcodeproj",
      team_id:               ENV["APPLE_TEAM_ID"],
      targets:               ["Clip"],
      bundle_identifier:     "com.bytspot.app.Clip",
      profile_uuid:          ENV["APP_CLIP_PROVISIONING_PROFILE_UUID"],
      code_sign_identity:    "Apple Distribution"
    )

    stripe_publishable_key = ENV["STRIPE_PUBLISHABLE_KEY"].to_s.strip
    if stripe_publishable_key.empty?
      UI.important("STRIPE_PUBLISHABLE_KEY is not set; native Apple Pay will fall back to card checkout.")
    end
    google_client_id = ENV["GOOGLE_CLIENT_ID"].to_s.strip

    # Build the signed .ipa with embedded App Clip
    build_app(
      project:       "App.xcodeproj",
      scheme:        "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle:          "manual",
        teamID:                ENV["APPLE_TEAM_ID"],
        provisioningProfiles:  {
          "com.bytspot.app"      => ENV["PROVISIONING_PROFILE_UUID"],
          "com.bytspot.app.Clip" => ENV["APP_CLIP_PROVISIONING_PROFILE_UUID"]
        }
      },
      output_directory: "./build",
      output_name:      "Bytspot.ipa",
      xcargs:           [
        "STRIPE_PUBLISHABLE_KEY=#{Shellwords.escape(stripe_publishable_key)}",
        "GOOGLE_CLIENT_ID=#{Shellwords.escape(google_client_id)}"
      ].join(" "),
      clean:            true
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key:                          api_key,
      ipa:                              "./build/Bytspot.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                        "Automated build from GitHub Actions"
    )
  end

  desc "Attach the latest TestFlight build to the App Store version and submit for review"
  lane :submit do |options|
    api_key = app_store_connect_api_key(
      key_id:        ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id:     ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content:   ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    target_build = (options[:build_number] || ENV["SUBMIT_BUILD_NUMBER"]).to_s.strip
    target_version = ENV["SUBMIT_APP_VERSION"].to_s.strip
    if target_build.empty?
      target_build = latest_testflight_build_number(
        api_key:        api_key,
        app_identifier: "com.bytspot.app"
      ).to_s
      target_version = Actions.lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION].to_s.strip
    end
    if target_version.empty?
      target_version = get_version_number(xcodeproj: "App.xcodeproj", target: "App").to_s.strip
    end
    UI.message("Submitting build #{target_build} of com.bytspot.app version #{target_version} for App Store review")

    deliver(
      api_key:                                api_key,
      app_identifier:                         "com.bytspot.app",
      app_version:                            target_version,
      build_number:                           target_build,
      submit_for_review:                      true,
      automatic_release:                      false,
      force:                                  true,
      skip_binary_upload:                     true,
      skip_metadata:                          true,
      skip_screenshots:                       true,
      precheck_include_in_app_purchases:      false,
      submission_information: {
        export_compliance_uses_encryption:               false,
        export_compliance_encryption_updated:            false,
        export_compliance_is_exempt:                     false,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_available_on_french_store:     false,
        content_rights_has_rights:                       true,
        content_rights_contains_third_party_content:     false,
        add_id_info_uses_idfa:                           false
      }
    )
  end
end

