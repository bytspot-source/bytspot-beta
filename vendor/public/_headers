# A cached service worker is the usual reason an installed app keeps booting
# an old build: the browser never sees the new worker, so it never updates.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/javascript

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# Hashed filenames, so these can be held forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vendor tools are not public inventory. The headers below are load-bearing now
# that a session lives on this origin: the refresh cookie is SameSite=Strict, so
# what remains to defend against is an injected script reading the in-memory
# access token and a framing attack driving the console from another page.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://bytspot-api.onrender.com; upgrade-insecure-requests
